# Database runtime roles. Run `npm run db:rls`, then `npm run db:provision-runtime`
# after placing Neon's pooled owner connection in DATABASE_OWNER_URL.
# Never add DATABASE_OWNER_URL to the production web runtime; it is for migrations only.
DATABASE_OWNER_URL=
DATABASE_URL=
APP_DATABASE_URL=
AUTH_DATABASE_URL=
VISITOR_DATABASE_URL=

# Authentication and visitor sessions
# Generate each value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Public app origin, with no trailing slash. QR links use this value.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional future direct-upload storage. Profile photos currently accept a hosted URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
