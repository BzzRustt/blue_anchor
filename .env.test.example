# Copy to .env.test.local (gitignored) and fill in. NEVER put production values here.
# Used only by: npm run test:dev | test:seed | test:check | test:* (see docs/TEST_ENVIRONMENT.md)
# The wrapper refuses to run unless every database URL points at a host listed in SCANME_TEST_DB_HOSTS.

# Comma-separated hostnames of your Neon TEST branch (the part between @ and /, without the port).
# Compare with your production host in Neon before filling in; they must differ.
SCANME_TEST_DB_HOSTS=

# Neon TEST branch connection strings (pooled owner URL for migrations and seeding).
DATABASE_OWNER_URL=
DATABASE_URL=
APP_DATABASE_URL=
AUTH_DATABASE_URL=
VISITOR_DATABASE_URL=

# Fresh random values for the test database only (do not reuse production secrets).
SESSION_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe TEST mode only: sk_test_..., a monthly test price id (price_...), and the whsec_ printed by `stripe listen`.
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Email is captured to .test-outbox/emails.jsonl by the wrapper (RESEND_API_KEY is forced empty).
RESEND_API_KEY=
EMAIL_FROM=test@example.test

# Optional: a SEPARATE Google OAuth client for the test origin. Leave empty to skip Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
